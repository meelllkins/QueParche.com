{
  "name": "queparche",
  "private": true,
  "version": "1.0.0",
  "description": "QueParche — plataforma para visibilizar la gastronomía callejera de Medellín",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "seed": "tsx server/db/seed.ts --reset",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.10.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.30.1",
    "tailwindcss": "4.1.12",
    "typescript": "5.7.2",
    "vite": "6.3.5"
  }
}
