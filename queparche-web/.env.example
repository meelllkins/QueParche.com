# ── QueParche — variables de entorno ──────────────────────────────
# Copia este archivo como `.env` y ajusta si lo necesitas.
# Todos los valores tienen un default razonable: la app arranca sin .env.

# Puerto del servidor API (y de la app completa en producción)
PORT=3001

# Base de datos.
# Local (default): archivo SQLite gestionado por libSQL. Se crea solo.
DATABASE_URL=file:data/queparche.db

# Producción con Turso (SQLite gestionado, plan gratuito):
#   1. turso db create queparche
#   2. turso db show queparche --url        → DATABASE_URL
#   3. turso db tokens create queparche     → DATABASE_AUTH_TOKEN
# DATABASE_URL=libsql://queparche-tuusuario.turso.io
# DATABASE_AUTH_TOKEN=
