# ============================================================
#  QueParche — .gitignore
#  Stack: Java (Maven, arquitectura hexagonal) + frontend HTML/CSS/JS
# ============================================================

# ── Compilación Java / Maven ────────────────────────────────
target/
*.class
*.jar
*.war
*.nar
*.ear

# Anclados a la raíz con "/" a propósito: sin la barra inicial, git
# ignoraría cualquier carpeta con ese nombre en cualquier nivel — y el
# dominio tiene paquetes legítimos como .../usuario/port/out/
/out/
/build/
/bin/

# ── Node / JavaScript (stack descartado; evitar recaídas) ───
node_modules/
dist/
.next/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# ── Variables de entorno y secretos ─────────────────────────
.env
.env.local
.env.*.local
*.pem

# ── Bases de datos locales ──────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── IDEs y editores ─────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
nbproject/private/

# ── Logs y temporales ───────────────────────────────────────
*.log
*.ctxt
.mtj.tmp/
*.zip
*.tar.gz
*.rar

# Volcados de fallo de la JVM
hs_err_pid*
replay_pid*

# ── Sistema operativo ───────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
